{
  "name": "@untangle-code/cli",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Local search and complexity harness for coding agents: code graphs, declared feature ownership and spec-to-code evidence.",
  "keywords": [
    "coding-agents",
    "mcp",
    "spec-driven-development",
    "code-complexity",
    "feature-complexity",
    "local-search",
    "ast"
  ],
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/lboel/untangle",
  "bugs": {
    "url": "https://github.com/lboel/untangle/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lboel/untangle.git",
    "directory": "apps/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "bin": {
    "untangle": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "default": "./dist/mcp/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/test-helpers.*",
    "!dist/**/test-support.*",
    "!dist/**/test-support/**",
    "!dist/**/testing/**",
    "!dist/**/__tests__/**",
    "src",
    "!src/**/*.test.ts",
    "!src/**/test-helpers.ts",
    "!src/**/test-support.ts",
    "!src/**/test-support/**",
    "!src/**/testing/**",
    "LICENSE",
    "NOTICE",
    "README.md",
    "THIRD_PARTY_LICENSES.md"
  ],
  "scripts": {
    "prepack": "node ../../scripts/prepack-guard.mjs",
    "pretest": "pnpm run build",
    "build": "node ../../scripts/tsc-build.mjs tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo",
    "build:watch": "tsc -p tsconfig.watch.json"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@untangle-code/chunker": "workspace:*",
    "@untangle-code/complexity": "workspace:*",
    "@untangle-code/config": "workspace:*",
    "@untangle-code/core": "workspace:*",
    "@untangle-code/domain": "workspace:*",
    "@untangle-code/embeddings-ollama": "workspace:*",
    "@untangle-code/extension-runtime": "workspace:*",
    "@untangle-code/file-graph": "workspace:*",
    "@untangle-code/graph-explorer": "workspace:*",
    "@untangle-code/jobs": "workspace:*",
    "@untangle-code/observability": "workspace:*",
    "@untangle-code/parser-registry": "workspace:*",
    "@untangle-code/scanner": "workspace:*",
    "@untangle-code/search": "workspace:*",
    "@untangle-code/storage-lancedb": "workspace:*",
    "@untangle-code/storage-local": "workspace:*",
    "@untangle-code/storage-qdrant": "workspace:*",
    "@untangle-code/symbol-graph": "workspace:*",
    "@untangle-code/watcher": "workspace:*",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "22.19.7",
    "@untangle-code/testkit": "workspace:*",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
