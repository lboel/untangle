{
  "name": "@untangle-code/mcp-server",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Private compatibility wrapper around the MCP runtime shipped by the public Untangle CLI package.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lboel/untangle.git",
    "directory": "apps/mcp-server"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/tsc-build.mjs tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@untangle-code/cli": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.19.7",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
