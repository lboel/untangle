{
  "name": "untangle-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first search and complexity harness for coding agents and spec-driven development.",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck && tsc -p tsconfig.scripts.json",
    "test": "pnpm -r --if-present run test",
    "test:unit": "vitest run",
    "lint": "eslint .",
    "lint:evidence": "node scripts/lint-evidence.mjs",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "pnpm -r --if-present run clean && node scripts/clean.mjs",
    "check-licenses": "node scripts/check-licenses.mjs",
    "check-publishable": "node scripts/check-publishable.mjs",
    "sync-licenses": "node scripts/sync-license-files.mjs",
    "third-party-licenses": "node scripts/gen-third-party-licenses.mjs",
    "complexity:report": "node scripts/complexity-report.mjs",
    "walk:messung": "node scripts/walk-messung.mjs",
    "walk:gegenprobe": "node scripts/walk-gegenprobe.mjs",
    "e2e:smoke": "node scripts/e2e-smoke.mjs && node scripts/feature-workflow-smoke.mjs && node scripts/quickstart-smoke.mjs && node scripts/init-setup-smoke.mjs",
    "e2e:setup": "node scripts/init-setup-smoke.mjs",
    "e2e:search": "node scripts/local-search-smoke.mjs",
    "grammar-provenance": "node scripts/astgrep-grammar-provenance.mjs",
    "e2e:release": "node scripts/release-smoke.mjs",
    "e2e:product": "node scripts/feature-workflow-smoke.mjs",
    "e2e:quickstart": "node scripts/quickstart-smoke.mjs",
    "setup:local": "node scripts/setup-local.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.19.7",
    "@untangle-code/chunker": "workspace:*",
    "@untangle-code/complexity": "workspace:*",
    "@untangle-code/domain": "workspace:*",
    "@untangle-code/parser-registry": "workspace:*",
    "@untangle-code/scanner": "workspace:*",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "3.2.7"
  }
}
