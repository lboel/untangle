{
  "name": "@untangle-code/extension-runtime",
  "version": "0.1.1",
  "private": false,
  "type": "module",
  "description": "Untangle analyzer-extension runtime: manifest loading and validation, output-format parsers (sarif, junit-xml, generic-findings, generic-metrics), license gate, pinned digests and the process/HTTP boundary. Knows output formats, never individual tools (extensions.md X9).",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/lboel/untangle",
  "bugs": {
    "url": "https://github.com/lboel/untangle/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lboel/untangle.git",
    "directory": "packages/extension-runtime"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/test-helpers.*",
    "!dist/**/test-support.*",
    "!dist/**/test-support/**",
    "!dist/**/testing/**",
    "!dist/**/__tests__/**",
    "src",
    "!src/**/*.test.ts",
    "!src/**/test-helpers.ts",
    "!src/**/test-support.ts",
    "!src/**/test-support/**",
    "!src/**/testing/**",
    "LICENSE",
    "NOTICE",
    "README.md",
    "THIRD_PARTY_LICENSES.md"
  ],
  "scripts": {
    "prepack": "node ../../scripts/prepack-guard.mjs",
    "build": "node ../../scripts/tsc-build.mjs tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@untangle-code/domain": "workspace:*",
    "fast-xml-parser": "5.11.1",
    "smol-toml": "1.8.0"
  },
  "devDependencies": {
    "@types/node": "22.19.7",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
