{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "example-analyzer",
          "version": "3.4.1",
          "informationUri": "https://example.invalid/analyzer",
          "rules": [
            {
              "id": "rules/no-dynamic-eval",
              "name": "NoDynamicEval",
              "shortDescription": { "text": "Dynamic evaluation of source text" },
              "fullDescription": { "text": "Evaluating strings as code allows injection." },
              "help": { "text": "Replace the dynamic evaluation with an explicit dispatch table." },
              "defaultConfiguration": { "level": "error" },
              "properties": { "tags": ["security"], "unknownFutureField": 42 }
            },
            {
              "id": "rules/prefer-const",
              "name": "PreferConst",
              "shortDescription": { "text": "Binding is never reassigned" },
              "defaultConfiguration": { "level": "note" }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "rules/no-dynamic-eval",
          "ruleIndex": 0,
          "level": "error",
          "message": { "text": "Do not evaluate user-supplied source text." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/handlers/webhook.ts", "uriBaseId": "%SRCROOT%" },
                "region": { "startLine": 12, "startColumn": 11, "endLine": 12, "endColumn": 33 }
              }
            }
          ],
          "properties": { "confidence": 0.95, "isHeuristic": false }
        },
        {
          "ruleIndex": 1,
          "message": { "text": "Binding \"total\" is never reassigned." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "file:///workspace/src/report/summary.ts" },
                "region": { "startLine": 4, "endLine": 6, "byteOffset": 87, "byteLength": 24 }
              }
            }
          ]
        },
        {
          "ruleId": "rules/no-dynamic-eval",
          "level": "warning",
          "message": { "text": "Do not evaluate user-supplied source text." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/handlers/webhook.ts" },
                "region": { "startLine": 20 }
              }
            },
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/handlers/legacy.ts" },
                "region": { "startLine": 3 }
              }
            }
          ]
        },
        {
          "ruleId": "rules/prefer-const",
          "level": "note",
          "message": { "text": "Result without any physical location." },
          "locations": []
        },
        {
          "level": "error",
          "message": { "text": "Result without a resolvable rule identifier." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/index.ts" },
                "region": { "startLine": 1 }
              }
            }
          ]
        }
      ],
      "invocations": [{ "executionSuccessful": true, "unknownFutureField": true }]
    }
  ]
}
