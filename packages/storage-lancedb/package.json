{
  "name": "@untangle-code/storage-lancedb",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Persistent local LanceDB storage for Untangle: real vector tables, collection metadata and cross-process serialized mutations.",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/lboel/untangle",
  "bugs": {
    "url": "https://github.com/lboel/untangle/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lboel/untangle.git",
    "directory": "packages/storage-lancedb"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/test-helpers.*",
    "!dist/**/test-support.*",
    "!dist/**/test-support/**",
    "!dist/**/testing/**",
    "!dist/**/__tests__/**",
    "src",
    "!src/**/*.test.ts",
    "!src/**/test-helpers.ts",
    "!src/**/test-support.ts",
    "!src/**/test-support/**",
    "!src/**/testing/**",
    "LICENSE",
    "NOTICE",
    "README.md",
    "THIRD_PARTY_LICENSES.md"
  ],
  "scripts": {
    "prepack": "node ../../scripts/prepack-guard.mjs",
    "build": "node ../../scripts/tsc-build.mjs tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@lancedb/lancedb": "0.30.0",
    "apache-arrow": "18.1.0",
    "@untangle-code/domain": "workspace:*",
    "@untangle-code/storage-qdrant": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.19.7",
    "@untangle-code/testkit": "workspace:*",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
